# ──────────────────────────────────────────────────
# UGSkill Frontend — Environment Variables Template
# Copy this file to .env.local (dev) or set these in
# your Vercel / hosting provider dashboard (production).
# DO NOT commit .env.local with real values.
# ──────────────────────────────────────────────────

# Backend REST API base URL (no trailing slash)
VITE_API_URL=http://localhost:4000/api/v1

# Backend WebSocket server URL (same host as API)
VITE_SOCKET_URL=http://localhost:4000
