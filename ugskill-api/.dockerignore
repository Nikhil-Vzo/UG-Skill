# ── Node ────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── TypeScript build output (builder stage handles this) ─
dist

# ── Environment secrets — NEVER bake into image ─────────
.env
.env.*
!.env.example

# ── Dev / test artifacts ─────────────────────────────────
*.test.ts
*.spec.ts
coverage
scratch
load
__tests__

# ── Editor / OS ──────────────────────────────────────────
.vscode
.idea
*.DS_Store
Thumbs.db

# ── Git ──────────────────────────────────────────────────
.git
.gitignore
