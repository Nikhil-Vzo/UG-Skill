# ─────────────────────────────────────────────────────────────
#  UGSkill API — Environment Variables Template
#  Copy this to .env and fill in your actual values.
#  NEVER commit .env to git — only this .env.example
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── PostgreSQL (Supabase) ──────────────────────────────────────
# Get from: supabase.com > Project > Settings > Database > Connection String
PG_DATABASE_URL=postgresql://postgres:<password>@<host>.supabase.co:5432/postgres

# ── MongoDB ───────────────────────────────────────────────────
# Railway: use the MONGO_URL provided in Railway's MongoDB service
# Atlas: get connection string from Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ugskill?retryWrites=true&w=majority

# ── Redis ──────────────────────────────────────────────────────
# Railway: use the REDIS_URL from Railway's Redis service
REDIS_URL=redis://default:<password>@<host>.railway.app:<port>

# ── JWT Secrets (generate with: openssl rand -hex 64) ─────────
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Security ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── AWS S3 (for file uploads) ─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ugskill-media

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@ugskill.in

# ── Sentry (Error Monitoring) ─────────────────────────────────
SENTRY_DSN=

# AI Proctoring Vision API
AI_API_URL=
AI_API_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://ugskill.vercel.app,https://ugskill.in
